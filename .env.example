# Скопируй в .env (локально) или добавь как Secrets в GitHub → Settings → Secrets and variables → Actions

ANTHROPIC_API_KEY=

# Instagram API with Instagram Login (профессиональный аккаунт Creator/Business)
IG_USER_ID=
IG_ACCESS_TOKEN=

# S3-совместимое хранилище для медиа (например, Cloudflare R2 с публичным доступом)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Публичный адрес бакета, например https://pub-xxxx.r2.dev
PUBLIC_MEDIA_BASE_URL=
